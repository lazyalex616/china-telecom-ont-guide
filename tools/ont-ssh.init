#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# 仅供已确认的 SAF 应用环境使用，不在光猫主系统或管理电脑上执行。
START=96
STOP=05

# 必须改成现场核实过的光猫管理 IPv4。占位符不会启动服务。
LISTEN_ADDRESS='REPLACE_WITH_VERIFIED_ONT_MANAGEMENT_IPV4'

valid_address() (
    case "$LISTEN_ADDRESS" in
        ''|*[!0-9.]*|.*|*.|*..*) exit 1 ;;
    esac
    IFS=.
    set -- $LISTEN_ADDRESS
    [ "$#" -eq 4 ] || exit 1
    for octet do
        case "$octet" in ''|????*|0[0-9]*) exit 1 ;; esac
        [ "$octet" -le 255 ] || exit 1
    done
    case "$1.$2" in
        10.*|192.168|172.1[6-9]|172.2[0-9]|172.3[01]) exit 0 ;;
    esac
    exit 1
)

start() {
    valid_address || {
        printf '%s\n' '请先核对并填写私有管理 IPv4，未启动 SSH' >&2
        return 1
    }
    if [ -r /var/run/ontssh.pid ]; then
        read -r pid < /var/run/ontssh.pid
        case "$pid" in ''|*[!0-9]*) return 1 ;; esac
        [ "$pid" -gt 1 ] 2>/dev/null || return 1
        if kill -0 "$pid" 2>/dev/null; then
            [ "$(readlink "/proc/$pid/exe")" = /opt/ontssh/dropbearmulti ]
            return $?
        fi
    fi
    [ -x /opt/ontssh/dropbearmulti ] || return 1
    [ -s /opt/ontssh/hostkey ] && [ -s /root/.ssh/authorized_keys ] || return 1
    /opt/ontssh/dropbearmulti dropbear \
        -p "$LISTEN_ADDRESS:22" -r /opt/ontssh/hostkey -P /var/run/ontssh.pid \
        -s -g -j -k -I 600 -K 30
}

boot() {
    valid_address || return 1
    # 应用启动时管理地址可能尚未就绪，只有限重试自己的服务。
    (
        attempt=0
        while [ "$attempt" -lt 30 ]; do
            start && exit 0
            attempt=$((attempt + 1))
            sleep 2
        done
        logger -t ontssh 'SSH 启动失败，未打开备用监听地址'
    ) </dev/null >/dev/null 2>&1 &
}

stop() {
    [ -r /var/run/ontssh.pid ] || return 0
    read -r pid < /var/run/ontssh.pid
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] 2>/dev/null || return 1
    kill -0 "$pid" 2>/dev/null || return 0
    [ "$(readlink "/proc/$pid/exe")" = /opt/ontssh/dropbearmulti ] || return 1
    kill "$pid"
}
